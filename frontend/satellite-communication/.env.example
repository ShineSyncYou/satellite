# 局域网瓦片（与页面同源部署，例如 nginx /tiles/day/ → D:/maps/tiles/day/）
# 外网可达时自动使用高德；仅局域网时直接 HTTP 加载下列路径
# 开发：Vite 代理 /tiles → localhost:8088
VITE_OFFLINE_DAY_TILE_URL=/tiles/day

# nginx 生产示例（同一端口）：
#   root  /path/to/dist;
#   location / { try_files $uri $uri/ /index.html; }
#   location /tiles/day/ { alias D:/maps/tiles/day/; }
